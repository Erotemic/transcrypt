      then ok (core.result.Result.Err Refusal.Request)
      else
        if value > MAX_PKT_LEN
        then ok (core.result.Result.Err Refusal.Request)
        else ok (core.result.Result.Ok value)
    else
      if value > MAX_PKT_LEN
      then ok (core.result.Result.Err Refusal.Request)
      else ok (core.result.Result.Ok value)
  else ok (core.result.Result.Err Refusal.Request)

end transcrypt_v3_core
