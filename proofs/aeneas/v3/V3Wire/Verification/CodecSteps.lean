import V3Wire.Extraction
import Transcrypt.V3WireCodec

/-!
Source-derived loop-body obligations for the production Rust v3 file codec.
These are about actual Aeneas-generated definitions in `Extraction/Funs.lean`.
They are the first step toward a *whole-loop* refinement: the final theorem
must still establish the exact 22-byte result for every 16-byte identifier.

No cryptographic operation is asserted here. In particular a successful
structural parse does not authenticate a ciphertext.
-/

open CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
open RustM ControlFlow
open Std.Do

namespace Transcrypt.V3Verification

/-- Exact *unproved* top-level target for file-header encoding. This directly
    names the production Rust function generated by Aeneas, and uses the
    independently authored wire magic. A successful RustM result is required:
    errors and divergence do not satisfy the WP specification. -/
def fullFileHeaderEncoderGoal
    (id : Aeneas.Std.Array Aeneas.Std.U8 16#usize) : Prop :=
  Aeneas.Std.WP.spec (transcrypt_v3_core.encode_file_header id)
    (fun out => out.val.map (fun b => b.val) =
      Transcrypt.V3Wire.fileMagic ++ id.val.map (fun b => b.val))

/-- Exact *unproved* top-level target for fixed-width header decoding.
    This is only the structural parser; it intentionally does not assert
    that its caller authenticated the file ciphertext. -/
def fullFileHeaderDecoderGoal
    (input : Aeneas.Std.Array Aeneas.Std.U8 22#usize) : Prop :=
  Aeneas.Std.WP.spec (transcrypt_v3_core.decode_file_header_exact input)
    (fun result => match result with
      | core.result.Result.Ok id =>
          input.val.map (fun b => b.val) =
            Transcrypt.V3Wire.fileMagic ++ id.val.map (fun b => b.val)
      | core.result.Result.Err transcrypt_v3_core.FormatError.Magic =>
          (input.val.map (fun b => b.val)).take 6 != Transcrypt.V3Wire.fileMagic
      | core.result.Result.Err transcrypt_v3_core.FormatError.Length => False)

/-- The production magic-byte loop advances and writes the expected byte at
    every in-range position. The `WP.spec` postcondition also rules out panic
    or divergence for that single step. -/
theorem extracted_header_magic_step
    (out : Aeneas.Std.Array Aeneas.Std.U8 22#usize)
    (i : Aeneas.Std.Usize) (hi : i.val < 6) :
    Aeneas.Std.WP.spec
      (transcrypt_v3_core.encode_file_header_loop0.body out i)
      (fun action => match action with
        | .cont (next, j) =>
            j.val = i.val + 1 ∧ next.val[i.val]! =
              transcrypt_v3_core.FILE_MAGIC.val[i.val]!
        | .done _ => False) := by
  unfold transcrypt_v3_core.encode_file_header_loop0.body
  -- These facts must be available *before* `step*`: the generated loop
  -- uses a usize index, and the array-update postcondition needs an
  -- in-range proof to simplify the resulting `List.set`/`getElem!`.
  have hmagic : transcrypt_v3_core.FILE_MAGIC.to_slice.len.val = 6 := by
    simp
  have hout : out.length = 22 := by
    simp
  simp only [CoreModels.core.slice.Slice.len,
    CoreModels.rust_primitives.slice.slice_length]
  -- `step*` must receive the final list-index solver here. Supplying it as
  -- a *follow-up* tactic is too late: failed `step*` would insert a hole.
  step* by simp_lists [*]

/-- The actual Rust ID-copy loop puts the arbitrary input byte at output
    offset 6+j and strictly advances its bounded counter. In particular the
    input is not limited to a finite set of test vectors. -/
theorem extracted_header_id_step
    (id : Aeneas.Std.Array Aeneas.Std.U8 16#usize)
    (out : Aeneas.Std.Array Aeneas.Std.U8 22#usize)
    (j : Aeneas.Std.Usize) (hj : j.val < 16) :
    Aeneas.Std.WP.spec
      (transcrypt_v3_core.encode_file_header_loop1.body id out j)
      (fun action => match action with
        | .cont (next, k) =>
            k.val = j.val + 1 ∧ next.val[6 + j.val]! = id.val[j.val]!
        | .done _ => False) := by
  unfold transcrypt_v3_core.encode_file_header_loop1.body
  -- The RustM loop uses an intermediate `s.len` and works on usize
  -- counters. Expose exact fixed-array lengths before symbolic execution;
  -- `omega` alone cannot infer them from dependent array types.
  have hmagic : transcrypt_v3_core.FILE_MAGIC.to_slice.len.val = 6 := by
    simp
  have hIDLen : transcrypt_v3_core.ID_LEN.val = 16 := by
    simp [transcrypt_v3_core.ID_LEN]
  have hid : id.length = 16 := by
    simp
  have hout : out.length = 22 := by
    simp
  have hdst : 6 + j.val < out.length := by omega
  simp only [CoreModels.core.slice.Slice.len,
    CoreModels.rust_primitives.slice.slice_length]
  -- Restrict the list simplifier to its safe rewrites: its full rule set
  -- recursively expands the 22-byte array term in the final postcondition.
  -- The fallback uses the precise Aeneas indexed-update lemma.
  step* by
    first
    | solve | simp_lists +safe [*]
    | solve | grind [Aeneas.Std.Array.getElem!_Nat_set_eq]

/-- The generated file-header decoder's data-copy step extracts precisely
    the corresponding byte from an arbitrary fixed-width input record. -/
theorem extracted_header_decode_id_step
    (input : Aeneas.Std.Array Aeneas.Std.U8 22#usize)
    (id : Aeneas.Std.Array Aeneas.Std.U8 16#usize)
    (j : Aeneas.Std.Usize) (hj : j.val < 16) :
    Aeneas.Std.WP.spec
      (transcrypt_v3_core.decode_file_header_exact_loop0_loop0.body
        input id j)
      (fun action => match action with
        | .cont (next, k) =>
            k.val = j.val + 1 ∧ next.val[j.val]! = input.val[6 + j.val]!
        | .done _ => False) := by
  unfold transcrypt_v3_core.decode_file_header_exact_loop0_loop0.body
  -- Both the input and destination have statically known lengths. The
  -- magic-prefix slice is six bytes, so its offset plus j is at most 21.
  have hmagic : transcrypt_v3_core.FILE_MAGIC.to_slice.len.val = 6 := by
    simp
  have hIDLen : transcrypt_v3_core.ID_LEN.val = 16 := by
    simp [transcrypt_v3_core.ID_LEN]
  have hinput : input.length = 22 := by
    simp
  have hid : id.length = 16 := by
    simp
  have hsrc : 6 + j.val < input.length := by omega
  have hdst : j.val < id.length := by omega
  simp only [CoreModels.core.slice.Slice.len,
    CoreModels.rust_primitives.slice.slice_length]
  step* by
    first
    | solve | simp_lists +safe [*]
    | solve | grind [Aeneas.Std.Array.getElem!_Nat_set_eq]

end Transcrypt.V3Verification
