# Port of Lean v4.31.0 (68218e8) to NetBSD and OpenBSD: runtime and linker
# flags only, no change to the kernel or elaborator. Apply with -p1 in both src/ and
# stage0/src/ of the Lean checkout; see ports/README.md.
--- a/runtime/bsd_exe_path.h
+++ b/runtime/bsd_exe_path.h
@@ -0,0 +1,45 @@
+/*
+Locating the running executable on NetBSD and OpenBSD, which have no
+/proc/<pid>/exe by default.
+*/
+#pragma once
+#if defined(__NetBSD__) || defined(__OpenBSD__)
+#include <sys/types.h>
+#include <sys/sysctl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <string>
+
+/* Writes the executable's absolute path to `out` (PATH_MAX bytes). */
+static inline bool lean_bsd_exe_path(char * out) {
+#if defined(__NetBSD__)
+    int mib[4] = {CTL_KERN, KERN_PROC_ARGS, -1, KERN_PROC_PATHNAME};
+    size_t len = PATH_MAX;
+    return sysctl(mib, 4, out, &len, nullptr, 0) == 0;
+#else
+    // OpenBSD records no executable path: resolve argv[0] the way exec did.
+    int mib[4] = {CTL_KERN, KERN_PROC_ARGS, getpid(), KERN_PROC_ARGV};
+    size_t len = 0;
+    if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0) return false;
+    std::string buf(len, '\0');
+    if (sysctl(mib, 4, &buf[0], &len, nullptr, 0) != 0) return false;
+    char const * argv0 = reinterpret_cast<char **>(&buf[0])[0];
+    if (argv0 == nullptr) return false;
+    if (strchr(argv0, '/') != nullptr) return realpath(argv0, out) != nullptr;
+    char const * path = getenv("PATH");
+    if (path == nullptr) return false;
+    std::string dirs(path);
+    for (size_t start = 0; start <= dirs.size();) {
+        size_t end = dirs.find(':', start);
+        if (end == std::string::npos) end = dirs.size();
+        std::string dir = end == start ? std::string(".") : dirs.substr(start, end - start);
+        std::string candidate = dir + "/" + argv0;
+        if (access(candidate.c_str(), X_OK) == 0 && realpath(candidate.c_str(), out) != nullptr) return true;
+        start = end + 1;
+    }
+    return false;
+#endif
+}
+#endif
