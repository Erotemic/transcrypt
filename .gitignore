# Rust workspace outputs. Keep rust/Cargo.lock tracked for reproducible CI.
target/

# Lean/Lake build products, including nested proof projects.
.lake/
*.olean
*.ilean

# Reproducible Charon/Aeneas output is regenerated from pinned Rust source.
/proofs/aeneas/generated/
/rust/proofs/aeneas/generated/

# Local Python test/proof-tool state (not Python runtime requirements).
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/

# Editor, local environment, and operating-system scratch files.
.idea/
.direnv/
.DS_Store
*~
*.swp
*.swo

# V3 pinned Aeneas proof package stages the single authoritative spec at
# build time; never commit duplicate copies of these files.
/proofs/aeneas/v3/Transcrypt/
/proofs/aeneas/v3/Transcrypt.lean

# Lake writes a dependency-free manifest for the standalone spec project.
/proofs/lean/lake-manifest.json
dist/
