# Rust workspace outputs. Keep rust/Cargo.lock tracked for reproducible CI.
target/

# Lean/Lake build products, including nested proof projects.
.lake/
*.olean
*.ilean

# Reproducible Charon/Aeneas output is regenerated from pinned Rust source.
/proofs/aeneas/generated/

# Local Python test/proof-tool state (not Python runtime requirements).
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/

# Editor, local environment, and operating-system scratch files.
.idea/
.direnv/
.DS_Store
*~
*.swp
*.swo
